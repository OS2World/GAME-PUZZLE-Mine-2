    HELPSUBITEM ID_POINTER_1,         HELP_PAGE_POINTER
    HELPSUBITEM ID_POINTER_2,         HELP_PAGE_POINTER
    HELPSUBITEM ID_POINTER_3,         HELP_PAGE_POINTER
    HELPSUBITEM ID_POINTER_4,         HELP_PAGE_POINTER
    HELPSUBITEM IDM_SUBMENU_SPECIAL,  HELP_PAGE_SPECIAL
    HELPSUBITEM IDM_STATISTIC,        HELP_PAGE_STATISTIC
    HELPSUBITEM IDM_HOF,              HELP_PAGE_HOF
    HELPSUBITEM IDM_SPECIAL_QUE,      HELP_PAGE_SPECIAL
    HELPSUBITEM IDM_SPECIAL_SAV,      HELP_PAGE_SPECIAL
    HELPSUBITEM IDM_SPECIAL_BIG,      HELP_PAGE_SPECIAL
    HELPSUBITEM IDM_SUBMENU_LANG,     HELP_PAGE_GENERAL
    HELPSUBITEM IDM_EXIT,             HELP_PAGE_EXIT
    HELPSUBITEM IDM_SUBMENU_HELP,     HELP_PAGE_GENERAL
    HELPSUBITEM IDM_HELPINDEX,        64045
    HELPSUBITEM IDM_HELPGENERAL,      64045
    HELPSUBITEM IDM_HELPUSING,        64045
    HELPSUBITEM IDM_HELPKEYS,         64045
    HELPSUBITEM IDM_ABOUT,            HELP_PAGE_ABOUT
}

